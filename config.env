# ============================================
# Fursona Bot Configuration
# ============================================

# --- Bot Settings ---
BOT_NAME=FursonaBot
BOT_VERSION=2.0.0

# Cooldowns (in seconds)
COOLDOWN_GENERATE=10
COOLDOWN_CUSTOM=30
COOLDOWN_TRADE=60
COOLDOWN_PROFILE=5

# Limits
MAX_FURSONAS_PER_USER=200
MAX_TRADES_PER_USER=5
FAVORITE_SLOTS=5

# --- Rarity System ---
# Rarity weights (higher = more common)
# Common: 50%, Uncommon: 25%, Rare: 15%, Epic: 8%, Legendary: 2%
RARITY_WEIGHTS_COMMON=50
RARITY_WEIGHTS_UNCOMMON=25
RARITY_WEIGHTS_RARE=15
RARITY_WEIGHTS_EPIC=8
RARITY_WEIGHTS_LEGENDARY=2

# Rarity colors for embeds
RARITY_COLOR_COMMON=#95A5A6
RARITY_COLOR_UNCOMMON=#2ECC71
RARITY_COLOR_RARE=#3498DB
RARITY_COLOR_EPIC=#9B59B6
RARITY_COLOR_LEGENDARY=#F39C12

# Rarity emojis
RARITY_EMOJI_COMMON=⚪
RARITY_EMOJI_UNCOMMON=🟢
RARITY_EMOJI_RARE=🔵
RARITY_EMOJI_EPIC=🟣
RARITY_EMOJI_LEGENDARY=🟡

# --- Species Rarity Assignment ---
# Format: "Species Name": "rarity"
# Rarities: common, uncommon, rare, epic, legendary
SPECIES_RARITY=Wolf:common,Fox:common,Cat:common,Dog:common,Rabbit:common,Horse:common,Deer:common,Bear:common,Raccoon:common,Otter:common,Squirrel:common,Bird:common,Lizard:common,Shark:common,Hyena:uncommon,Panther:uncommon,Tiger:uncommon,Lion:uncommon,Cheetah:uncommon,Leopard:uncommon,Jaguar:uncommon,Coyote:uncommon,Jackal:uncommon,Dingo:uncommon,Husky:uncommon,Malamute:uncommon,Akita:uncommon,Shiba:uncommon,Border Collie:uncommon,German Shepherd:uncommon,Golden Retriever:uncommon,Labrador:uncommon,Poodle:uncommon,Corgi:uncommon,Pug:uncommon,Bulldog:uncommon,Beagle:uncommon,Dachshund:uncommon,Siamese:rare,Maine Coon:rare,Persian:rare,Bengal:rare,Sphynx:rare,Ragdoll:rare,Red Panda:rare,Giant Panda:rare,Koala:rare,Kangaroo:rare,Platypus:rare,Echidna:rare,Arctic Fox:epic,Fennec Fox:epic,Gray Fox:epic,Kit Fox:epic,Swift Fox:epic,Dragon:legendary

# --- Pattern Rarities ---
PATTERN_RARITY=Solid:common,Tabby:common,Calico:uncommon,Tortoiseshell:uncommon,Tuxedo:uncommon,Spotted:common,Striped:common,Marbled:uncommon,Merle:rare,Brindle:rare,Roan:rare,Appaloosa:rare,Piebald:epic,Sable:epic,Agouti:epic,Pointed:epic,Mitted:epic,Bicolor:rare,Harlequin:legendary,Irish Spotting:rare,Ticking:uncommon,Countershading:uncommon

# --- Trait Rarities ---
TRAIT_RARITY=Heterochromia:rare,Glowing markings:epic,Multiple tails:epic,Wings:legendary,Horns:rare,Scales:uncommon,Feathers:uncommon,Bioluminescence:epic,Shapeshifting:legendary,Telepathy:legendary,Elemental affinity:legendary,Phasing:legendary,Invisibility:legendary,Regeneration:epic,Luck manipulation:epic,Dream walking:rare,Time perception:legendary,Sound vision:rare

# --- Colors by Rarity ---
# Common colors (natural)
COLOR_COMMON=#8B4513,#A0522D,#D2691E,#CD853F,#F4A460,#DEB887,#D2B48C,#BC8F8F,#FFDAB9,#FFE4B5,#FFF8DC,#F5F5DC,#FAEBD7,#FFEBCD,#FFDEAD,#FFE4C4
# Uncommon colors
COLOR_UNCOMMON=#CD5C5C,#F08080,#E9967A,#FF7F50,#FF6347,#FF4500,#FF8C00,#FFA500,#FFB84D,#FFCC00,#FFD700,#FFFF00,#FFFFE0,#FFFACD,#FFF8DC,#F0E68C
# Rare colors
COLOR_RARE=#98FB98,#90EE90,#32CD32,#228B22,#008000,#006400,#2E8B57,#3CB371,#20B2AA,#40E0D0,#48D1CC,#00CED1,#5F9EA0,#4682B4,#6495ED,#4169E1
# Epic colors
COLOR_EPIC=#9370DB,#8A2BE2,#9932CC,#BA55D3,#DA70D6,#D8BFD8,#E6E6FA,#DDA0DD,#EE82EE,#FF00FF,#FF1493,#DB7093,#C71585,#FF69B4,#FFB6C1,#FFC0CB
# Legendary colors
COLOR_LEGENDARY=#FFD700,#FFA500,#FF4500,#FF0000,#8B0000,#4B0082,#000080,#000000,#FFFFFF,#C0C0C0,#808080

# --- Embed Settings ---
EMBED_COLOR_DEFAULT=#4ECDC4
EMBED_FOOTER_TEXT=FursonaBot v2.0 • Made with 💜
EMBED_THUMBNAIL_URL=https://cdn.discordapp.com/emojis/1234567890123456789.png

# --- Image Generation (Placeholder) ---
# Set to true to enable placeholder image URLs
ENABLE_PLACEHOLDER_IMAGES=true
PLACEHOLDER_IMAGE_BASE=https://via.placeholder.com/400x400

# --- Feature Flags ---
ENABLE_TRADING=true
ENABLE_PROFILES=true
ENABLE_LEADERBOARD=true
ENABLE_CUSTOM_FURSONA=true
ENABLE_FAVORITES=true
ENABLE_COLLECTION=true

# --- Logging ---
LOG_LEVEL=info
LOG_CHANNEL_ID=

# --- Development ---
DEBUG_MODE=false
TEST_GUILD_ID=